import Secp256k1.Primality

/-!
# Primality of `p` and `n`

Pratt certificates generated by `scripts/gen_pratt_certificates.py`; do not
edit by hand. Each prime `q` is certified by the Lucas test with a witness
`a` and the factorisation of `q - 1` into primes certified earlier in the
file. Every check is evaluated by the Lean kernel (`decide +kernel`).
-/

namespace Secp256k1.Certificates

open Secp256k1

