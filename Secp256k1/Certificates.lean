/-- The Lucas certificate for `p`. -/
theorem p_cert : LucasCert p 3 [(2, 1), (3, 1), (7, 1), (13441, 1), (205115282021455665897114700593932402728804164701536103180137503955397371, 1)] :=
  LucasCert.of_check (by decide +kernel) (.cons prime_two (.cons prime_3 (.cons prime_7 (.cons prime_13441 (.cons prime_205115282021455665897114700593932402728804164701536103180137503955397371 .nil)))))

/-- The Lucas certificate for `n`. -/
theorem n_cert : LucasCert n 7 [(2, 6), (3, 1), (149, 1), (631, 1), (107361793816595537, 1), (174723607534414371449, 1), (341948486974166000522343609283189, 1)] :=
  LucasCert.of_check (by decide +kernel) (.cons prime_two (.cons prime_3 (.cons prime_149 (.cons prime_631 (.cons prime_107361793816595537 (.cons prime_174723607534414371449 (.cons prime_341948486974166000522343609283189 .nil)))))))

end Secp256k1.Certificates

namespace Secp256k1

/-- The field prime `p` is prime. -/
theorem p_isPrime : IsPrime p := Certificates.p_cert.isPrime

/-- The group order `n` is prime. -/
theorem n_isPrime : IsPrime n := Certificates.n_cert.isPrime

/-- Fermat's little theorem modulo `p`. -/
theorem fermat_p (x : Nat) (h0 : 0 < x) (h : x < p) : x ^ (p - 1) % p = 1 :=
  Certificates.p_cert.fermat x h0 h

/-- Fermat's little theorem modulo `n`. -/
theorem fermat_n (x : Nat) (h0 : 0 < x) (h : x < n) : x ^ (n - 1) % n = 1 :=
  Certificates.n_cert.fermat x h0 h

end Secp256k1
