import Secp256k1.Bytes
import Secp256k1.Field

/-!
# The secp256k1 curve group

Points on `E : y² = x³ + 7` over `𝔽ₚ`. The public API works with affine
`Point`s; arithmetic is carried out internally in Jacobian coordinates
`(X : Y : Z) ↦ (X/Z², Y/Z³)` so that only one field inversion is needed per
scalar multiplication.
-/

namespace Secp256k1

/-- An affine point on secp256k1, or the point at infinity `𝒪`. -/
inductive Point where
  | infinity
  | affine (x y : Fp)
  deriving DecidableEq, Repr, Inhabited

/-- The curve coefficient `b = 7` (the coefficient `a` is `0`). -/
def b : Fp := 7

namespace Point

/-- Whether the point satisfies `y² = x³ + 7` (`𝒪` counts as on the curve). -/
def isOnCurve : Point → Bool
  | .infinity => true
  | .affine x y => y * y == x * x * x + b

/-- Whether the point is a valid public key point: on the curve and not `𝒪`.
Since the cofactor is 1, every such point lies in the subgroup generated by `G`. -/
def isValid : Point → Bool
  | .infinity => false
  | P@(.affine _ _) => P.isOnCurve

/-- The x-coordinate (if not `𝒪`). -/
def x? : Point → Option Fp
  | .infinity => none
  | .affine x _ => some x

/-- Point negation `(x, y) ↦ (x, -y)`. -/
def neg : Point → Point
  | .infinity => .infinity
  | .affine x y => .affine x (-y)

instance : Neg Point := ⟨neg⟩

/-- Recover the point with x-coordinate `x` whose y-coordinate has the given
parity, if `x³ + 7` is a square. -/
def lift? (x : Fp) (odd : Bool) : Option Point := do
  let y ← Fp.sqrt? (x * x * x + b)
  let y := if y.isOdd == odd then y else -y
  -- y = 0 is impossible on secp256k1 (x³ = -7 has no solution in 𝔽ₚ) but keep the check honest.
  if y.isOdd == odd then some (.affine x y) else none

end Point

/-- The base point `G`. -/
def G : Point := .affine (Fp.ofNat Gx) (Fp.ofNat Gy)

theorem G_isValid : G.isValid = true := by decide

/-- A point in Jacobian coordinates; `Z = 0` represents `𝒪`. -/
structure Jacobian where
  X : Fp
  Y : Fp
  Z : Fp
  deriving Repr, Inhabited

namespace Jacobian

/-- The point at infinity. -/
def infinity : Jacobian := ⟨1, 1, 0⟩

/-- Whether this represents `𝒪`. -/
@[inline] def isInfinity (P : Jacobian) : Bool := P.Z == 0

/-- Embed an affine point. -/
def ofPoint : Point → Jacobian
  | .infinity => infinity
  | .affine x y => ⟨x, y, 1⟩

/-- Convert back to affine coordinates (one field inversion). -/
def toPoint (P : Jacobian) : Point :=
  if P.isInfinity then .infinity
  else
    let zi := Fp.inv P.Z
    let zi2 := zi * zi
    .affine (P.X * zi2) (P.Y * zi2 * zi)

/-- Point doubling for `a = 0`. -/
def double (P : Jacobian) : Jacobian :=
  if P.isInfinity || P.Y == 0 then infinity
  else
    let Y2 := P.Y * P.Y
    let S := 4 * P.X * Y2
    let M := 3 * P.X * P.X
    let X3 := M * M - 2 * S
    let Y3 := M * (S - X3) - 8 * Y2 * Y2
    let Z3 := 2 * P.Y * P.Z
    ⟨X3, Y3, Z3⟩

/-- General point addition, handling `𝒪`, `P + P` and `P + (-P)`. -/
def add (P Q : Jacobian) : Jacobian :=
  if P.isInfinity then Q
  else if Q.isInfinity then P
  else
    let Z1Z1 := P.Z * P.Z
    let Z2Z2 := Q.Z * Q.Z
    let U1 := P.X * Z2Z2
    let U2 := Q.X * Z1Z1
    let S1 := P.Y * Q.Z * Z2Z2
    let S2 := Q.Y * P.Z * Z1Z1
    if U1 == U2 then
      if S1 == S2 then double P else infinity
    else
      let H := U2 - U1
      let R := S2 - S1
      let H2 := H * H
      let H3 := H2 * H
      let U1H2 := U1 * H2
      let X3 := R * R - H3 - 2 * U1H2
      let Y3 := R * (U1H2 - X3) - S1 * H3
      let Z3 := H * P.Z * Q.Z
      ⟨X3, Y3, Z3⟩

/-- Scalar multiplication `k • P` by left-to-right double-and-add. -/
def smul (k : Nat) (P : Jacobian) : Jacobian :=
  go (k.log2 + 1) infinity
where
  go : Nat → Jacobian → Jacobian
    | 0, acc => acc
    | i + 1, acc =>
      let acc := acc.double
      go i (if k.testBit i then acc.add P else acc)

/-- Double scalar multiplication `a • P + b • Q` using Shamir's trick
(one shared doubling chain). -/
def smulAdd (a : Nat) (P : Jacobian) (b : Nat) (Q : Jacobian) : Jacobian :=
  go (P.add Q) (max a.log2 b.log2 + 1) infinity
where
  go (PQ : Jacobian) : Nat → Jacobian → Jacobian
    | 0, acc => acc
    | i + 1, acc =>
      let acc := acc.double
      let acc := match a.testBit i, b.testBit i with
        | true, true => acc.add PQ
        | true, false => acc.add P
        | false, true => acc.add Q
        | false, false => acc
      go PQ i acc

end Jacobian

namespace Point

/-- Group addition on affine points. -/
def add (P Q : Point) : Point :=
  (Jacobian.ofPoint P |>.add (Jacobian.ofPoint Q)).toPoint

instance : Add Point := ⟨add⟩

instance : Sub Point := ⟨fun P Q => P + -Q⟩

/-- Scalar multiplication `k • P`. -/
def smul (k : Nat) (P : Point) : Point :=
  (Jacobian.smul k (Jacobian.ofPoint P)).toPoint

instance : SMul Nat Point := ⟨smul⟩

/-- `a • P + b • Q`, computed with a single doubling chain. -/
def smulAdd (a : Nat) (P : Point) (b : Nat) (Q : Point) : Point :=
  (Jacobian.smulAdd a (Jacobian.ofPoint P) b (Jacobian.ofPoint Q)).toPoint

/-! ### SEC 1 encoding (§2.3.3 / §2.3.4) -/

/-- SEC 1 encoding of a point: `0x02/0x03 ‖ x` (compressed, 33 bytes),
`0x04 ‖ x ‖ y` (uncompressed, 65 bytes), or `0x00` for `𝒪`. -/
def toBytes (P : Point) (compressed : Bool := true) : ByteArray :=
  match P with
  | .infinity => ByteArray.mk #[0x00]
  | .affine x y =>
    if compressed then
      (ByteArray.mk #[if y.isOdd then 0x03 else 0x02]) ++ natToBytes x.val 32
    else
      (ByteArray.mk #[0x04]) ++ natToBytes x.val 32 ++ natToBytes y.val 32

/-- Parse a SEC 1 encoded point (compressed or uncompressed). Rejects
coordinates `≥ p`, points not on the curve, and the encoding of `𝒪`. -/
def ofBytes? (bs : ByteArray) : Option Point :=
  if bs.size == 33 && (bs[0]! == 0x02 || bs[0]! == 0x03) then
    let x := bytesToNat (bs.extract 1 33)
    if h : x < p then lift? ⟨x, h⟩ (bs[0]! == 0x03) else none
  else if bs.size == 65 && bs[0]! == 0x04 then
    let x := bytesToNat (bs.extract 1 33)
    let y := bytesToNat (bs.extract 33 65)
    if h : x < p ∧ y < p then
      let P := Point.affine ⟨x, h.1⟩ ⟨y, h.2⟩
      if P.isOnCurve then some P else none
    else none
  else none

end Point

end Secp256k1
